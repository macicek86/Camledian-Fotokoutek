<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Camledian.Photobooth.Printing</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.9" />
    <!-- Serial (COM) transport for ESC/POS receipt printers — paired Bluetooth POS printers appear
         as virtual COM ports on Windows (Bluetooth SPP). -->
    <PackageReference Include="System.IO.Ports" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Camledian.Photobooth.Core\Camledian.Photobooth.Core.csproj" />
    <ProjectReference Include="..\Camledian.Photobooth.Imaging\Camledian.Photobooth.Imaging.csproj" />
    <ProjectReference Include="..\Camledian.Photobooth.Printing\Camledian.Photobooth.Printing.csproj" />
  </ItemGroup>

</Project>
