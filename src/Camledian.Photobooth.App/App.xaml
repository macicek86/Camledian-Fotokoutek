<Application x:Class="Camledian.Photobooth.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Camledian.Photobooth.App"
             xmlns:conv="clr-namespace:Camledian.Photobooth.App.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- WPF UI (lepoco) supplies Fluent ControlTemplates for the stock WPF controls the Admin
                 screen uses. Before this, every one of them (TextBox/PasswordBox/CheckBox/Slider/
                 ComboBox/TabControl) needed a hand-written ControlTemplate here, because the Windows
                 theme draws them white/grey regardless of Background/Foreground setters. The kiosk-facing
                 brand styles below are still ours — WPF UI only provides the chrome underneath.

                 Must come first: the implicit styles further down reference these dictionaries via
                 StaticResource, which resolves in XAML document order. -->
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <conv:FilePathToImageConverter x:Key="FilePathToImageConverter" />
            <conv:StateToVisibilityConverter x:Key="StateToVisibilityConverter" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />

            <!-- Brand palette. BrandAccentColor is also pushed into WPF UI's own accent resources at
                 startup (see App.xaml.cs) so Fluent controls highlight in the brand colour, not the
                 Windows blue WPF UI ships with. -->
            <Color x:Key="BrandAccentColor">#FF5A3C</Color>
            <SolidColorBrush x:Key="BackgroundBrush" Color="#111318" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#1C2029" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource BrandAccentColor}" />
            <SolidColorBrush x:Key="TextBrush" Color="#F5F5F5" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#A0A6B0" />

            <!-- Kiosk-facing styles: deliberately NOT based on the WPF UI button. These are giant touch
                 targets for a photobooth, not desktop buttons. -->
            <Style x:Key="KioskButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="32" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="48,24" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="MinWidth" Value="280" />
                <Setter Property="MinHeight" Value="90" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="16"
                                    Padding="{TemplateBinding Padding}"
                                    Opacity="{TemplateBinding Tag}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Tag" Value="1" />
                <Style.Triggers>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Tag" Value="0.75" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Tag" Value="0.9" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="KioskSecondaryButton" TargetType="Button" BasedOn="{StaticResource KioskButton}">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="MinWidth" Value="180" />
                <Setter Property="MinHeight" Value="64" />
            </Style>

            <!-- Picker tiles (background / burst-shot chooser) are an image in a Border, with the Button
                 acting only as the hit target. Without an explicit style they would pick up WPF UI's
                 implicit Button chrome — rounded fill, hover highlight and accent underline drawn around
                 each thumbnail. -->
            <Style x:Key="PhotoTileButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" Opacity="{TemplateBinding Tag}">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Tag" Value="1" />
                <Style.Triggers>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Tag" Value="0.7" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Tag" Value="0.85" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ScreenTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontSize" Value="48" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>

            <Style x:Key="ScreenSubtitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="FontSize" Value="22" />
            </Style>

            <!-- Admin form rhythm. WPF UI already templates these controls; all that is left here is the
                 vertical spacing and type scale AdminView.xaml lays its stacked fields out with — the old
                 hand-rolled templates baked those margins in, so dropping them without this would collapse
                 every field in the Admin screen against its neighbour. Each BasedOn points at WPF UI's
                 implicit style for that control (keyed by {x:Type T}), inheriting the Fluent template
                 instead of replacing it. -->
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                <Setter Property="FontSize" Value="16" />
            </Style>

            <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
