<Application x:Class="Camledian.Photobooth.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Camledian.Photobooth.App"
             xmlns:conv="clr-namespace:Camledian.Photobooth.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <conv:FilePathToImageConverter x:Key="FilePathToImageConverter" />
            <conv:StateToVisibilityConverter x:Key="StateToVisibilityConverter" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />

            <SolidColorBrush x:Key="BackgroundBrush" Color="#111318" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#1C2029" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FF5A3C" />
            <SolidColorBrush x:Key="TextBrush" Color="#F5F5F5" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#A0A6B0" />

            <Style x:Key="KioskButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="32" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="48,24" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="MinWidth" Value="280" />
                <Setter Property="MinHeight" Value="90" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="16"
                                    Padding="{TemplateBinding Padding}"
                                    Opacity="{TemplateBinding Tag}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Tag" Value="1" />
                <Style.Triggers>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Tag" Value="0.75" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Tag" Value="0.9" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="KioskSecondaryButton" TargetType="Button" BasedOn="{StaticResource KioskButton}">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="MinWidth" Value="180" />
                <Setter Property="MinHeight" Value="64" />
            </Style>

            <Style x:Key="ScreenTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontSize" Value="48" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>

            <Style x:Key="ScreenSubtitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="FontSize" Value="22" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
