<UserControl x:Class="Camledian.Photobooth.App.Views.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" CornerRadius="12" ClipToBounds="True" Background="Black">
            <Image Source="{Binding ResultImage}" Stretch="Uniform" />
        </Border>

        <StackPanel Grid.Column="1" Margin="40,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Hotovo!" Style="{StaticResource ScreenTitle}" Margin="0,0,0,24" />

            <Button Content="VYTISKNOUT" Style="{StaticResource KioskButton}" Margin="0,0,0,16"
                    Command="{Binding PrintCommand}" />
            <Button Content="ZNOVU" Style="{StaticResource KioskSecondaryButton}" Margin="0,0,0,16"
                    Command="{Binding RetakeCommand}" />
            <Button Content="HOTOVO" Style="{StaticResource KioskSecondaryButton}" Margin="0,0,0,32"
                    Command="{Binding DoneCommand}" />

            <TextBlock Text="{Binding SyncStatusMessage}" Style="{StaticResource ScreenSubtitle}" TextWrapping="Wrap" Margin="0,0,0,12" />

            <Border Width="160" Height="160" Background="White" CornerRadius="8"
                    Visibility="{Binding QrCodeImage, Converter={StaticResource NullToVisibilityConverter}}">
                <Image Source="{Binding QrCodeImage}" Margin="8" />
            </Border>

            <Button Content="VYTISKNOUT QR KÓD" Style="{StaticResource KioskSecondaryButton}" Margin="0,16,0,0"
                    Command="{Binding PrintReceiptCommand}"
                    Visibility="{Binding Settings.ReceiptPrinter.Enabled, Converter={StaticResource BoolToVisibilityConverter}}" />

            <TextBlock Text="Tisknu..." Foreground="{StaticResource AccentBrush}" FontSize="22" Margin="0,16,0,0"
                       Visibility="{Binding State, Converter={StaticResource StateToVisibilityConverter}, ConverterParameter=Printing}" />
        </StackPanel>
    </Grid>
</UserControl>
