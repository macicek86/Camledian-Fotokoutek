<UserControl x:Class="Camledian.Photobooth.App.Views.LiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720">
    <Grid Background="Black">
        <Image Source="{Binding PreviewImage}" Stretch="Uniform" />

        <!-- Countdown overlay covers the whole preview, per spec §14 -->
        <Grid Background="#66000000"
              Visibility="{Binding State, Converter={StaticResource StateToVisibilityConverter}, ConverterParameter=Countdown}">
            <TextBlock Text="{Binding CountdownValue}" FontSize="320" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!-- Burst capture overlay: smile prompt + shot counter while the shots are being taken -->
        <Grid Visibility="{Binding State, Converter={StaticResource StateToVisibilityConverter}, ConverterParameter=Capturing}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0">
                <TextBlock Text="{Binding Settings.Ui.SmilePromptText}" FontSize="96" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="Black" Opacity="0.8" />
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock FontSize="32" Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="Black" Opacity="0.8" />
                    </TextBlock.Effect>
                    <Run Text="Snímek " /><Run Text="{Binding BurstShotIndex, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding BurstShotTotal, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Preview controls: only shown before the countdown starts -->
        <Grid VerticalAlignment="Bottom" Margin="0,0,0,88"
              Visibility="{Binding State, Converter={StaticResource StateToVisibilityConverter}, ConverterParameter=Preview}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="ZPĚT" Style="{StaticResource KioskSecondaryButton}"
                        Command="{Binding BackToBackgroundSelectionCommand}" Margin="0,0,32,0" />
                <Button Content="VYFOTIT" Style="{StaticResource KioskButton}" FontSize="40" Padding="72,32"
                        Command="{Binding StartCountdownCommand}" />
            </StackPanel>
        </Grid>

        <Button Content="Zrušit" Style="{StaticResource KioskSecondaryButton}" FontSize="18"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="24"
                Command="{Binding CancelCountdownCommand}"
                Visibility="{Binding State, Converter={StaticResource StateToVisibilityConverter}, ConverterParameter=Countdown}" />
    </Grid>
</UserControl>
