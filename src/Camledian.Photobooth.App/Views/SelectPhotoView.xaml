<UserControl x:Class="Camledian.Photobooth.App.Views.SelectPhotoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Vyberte svou fotku" Style="{StaticResource ScreenTitle}" />
            <TextBlock Text="Klepněte na snímek, který chcete použít." Style="{StaticResource ScreenSubtitle}" Margin="0,8,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding BurstShots}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectBurstShotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Margin="16" Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand">
                            <StackPanel>
                                <Border CornerRadius="12" ClipToBounds="True" BorderThickness="4" BorderBrush="{StaticResource SurfaceBrush}">
                                    <Image Source="{Binding Thumbnail}" Width="360" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextBrush}"
                                           FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2" Content="ZNOVU VYFOTIT" Style="{StaticResource KioskSecondaryButton}"
                Command="{Binding RetakeBurstCommand}" HorizontalAlignment="Center" Margin="0,24,0,0" />

        <!-- Brand watermark: spans all rows so Bottom alignment resolves against the whole screen, not just Row 0 -->
        <StackPanel Grid.Row="0" Grid.RowSpan="3" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Opacity="0.6" IsHitTestVisible="False">
            <Image Source="{Binding LogoEmblemPath, Converter={StaticResource FilePathToImageConverter}, ConverterParameter=80}" Height="28" Stretch="Uniform" Margin="0,0,8,0" />
            <TextBlock Text="CAMLEDIAN FOTOKOUTEK" FontSize="13" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
