# Copy this file to .dev.vars for local `wrangler dev` (that file is gitignored — never commit real
# secrets). In production these are set with `wrangler secret put <NAME>` instead.

# Bootstrap/server-to-server key: creates the first /admin account (POST /admin/setup) and gates
# POST /api/photobooth/pair/confirm. Day-to-day admin use goes through /admin/login instead, which
# has its own accounts + sessions (spec §31/§36/§44/§56).
ADMIN_API_KEY=change-me-to-a-random-string

# No R2 API token is needed: photo uploads go through the Worker's own ASSETS_BUCKET binding
# (see routes/photos.ts), not through presigned S3-API URLs.
