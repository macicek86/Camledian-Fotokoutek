{
  "name": "camledian-photobooth-backend",
  "version": "1.0.0",
  "description": "Cloudflare Worker backend (config sync, device pairing, photo upload, QR gallery) for Camledian Photobooth",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply camledian-photobooth --local",
    "db:migrate:remote": "wrangler d1 migrations apply camledian-photobooth --remote",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "itty-router": "5.0.24"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  }
}
